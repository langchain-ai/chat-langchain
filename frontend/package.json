{
  "name": "chat-langchain",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "cross-env NEXT_PUBLIC_LANGGRAPH_API_URL=http://127.0.0.1:2024 next dev",
    "dev:remote": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test __tests__/*.test.mts",
    "typecheck": "tsc --noEmit",
    "dev:demo": "cross-env MACAW_SMOKE_TEST=1 next dev"
  },
  "dependencies": {
    "@langchain/langgraph-sdk": "^1.9.18",
    "@langchain/macaw-components": "1.7.4",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "clsx": "^2.1.1",
    "langsmith": "^0.6.0",
    "next": "16.4.3",
    "nuqs": "^2.7.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "^10.1.0",
    "postcss": "^8.5",
    "tailwindcss": "4.3.4",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
